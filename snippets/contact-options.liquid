{%- comment -%} Contact page: Chat Now & Send a Message options {%- endcomment -%}

<style>
  .contact-options .multicolumn-card__info {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2.5rem;
  }
  .contact-options .multicolumn-card__info .button {
    margin-top: 1.5rem;
  }
  .contact-options .multicolumn-card__info .button.active {
    opacity: 0.7;
    pointer-events: none;
  }
  .contact-options {
    gap: 36px;
  }
  .contact-options .multicolumn-list__item {
    display: flex;
  }
  .contact-options .multicolumn-card {
    width: 100%;
    background: rgb(var(--color-background))
      linear-gradient(rgba(var(--color-foreground), 0.04), rgba(var(--color-foreground), 0.04));
  }
  .contact-options .contact-option-icon {
    width: 48px;
    height: 48px;
    margin-bottom: 0.5rem;
  }
  .contact-form-embed {
    max-width: 700px;
    margin: 0 auto;
    padding: 2rem 0;
    display: none;
  }
  .contact-form-embed.is-visible {
    display: block;
  }
</style>

<div class="page-width">
  <ul class="contact-options multicolumn-list grid grid--2-col-desktop grid--1-col-tablet-down" role="list">
    <li class="multicolumn-list__item grid__item">
      <div class="multicolumn-card content-container">
        <div class="multicolumn-card__info center">
          <svg class="contact-option-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          <h3 class="inline-richtext">CHAT NOW</h3>
          <div class="rte">
            <p>Get instant help from our virtual assistant</p>
          </div>
          <button type="button" id="contact-opt-chat" class="button button--primary" aria-pressed="false">Chat Now</button>
        </div>
      </div>
    </li>
    <li class="multicolumn-list__item grid__item">
      <div class="multicolumn-card content-container">
        <div class="multicolumn-card__info center">
          <svg class="contact-option-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          <h3 class="inline-richtext">SEND US A MESSAGE</h3>
          <div class="rte">
            <p>Fill out our form and we'll get back to you</p>
          </div>
          <button type="button" id="contact-opt-message" class="button button--primary" aria-pressed="false">Send Us a Message</button>
        </div>
      </div>
    </li>
  </ul>

  <div class="contact-form-embed" id="contact-form-embed" aria-live="polite"></div>
</div>

<script>
  (function() {
    var chatBtn = document.getElementById('contact-opt-chat');
    var msgBtn = document.getElementById('contact-opt-message');
    var formContainer = document.getElementById('contact-form-embed');
    var formLoaded = false;

    function isChatOpen() {
      var children = document.body.children;
      for (var i = 0; i < children.length; i++) {
        if (children[i].shadowRoot) {
          var container = children[i].shadowRoot.querySelector('.livesdk__chat-sdk-window__container');
          if (container) return getComputedStyle(container).display !== 'none';
        }
      }
      return false;
    }

    function clickInvitation() {
      var inv = document.querySelector('#livesdk__campaign .livesdk__invitation');
      if (inv) { inv.click(); return true; }
      return false;
    }

    function openChat() {
      chatBtn.classList.add('active');
      chatBtn.setAttribute('aria-pressed', 'true');
      msgBtn.classList.remove('active');
      msgBtn.setAttribute('aria-pressed', 'false');
      formContainer.classList.remove('is-visible');

      // Only open if not already open
      if (!isChatOpen()) {
        if (!clickInvitation()) {
          var attempts = 0;
          var retryInterval = setInterval(function() {
            attempts++;
            if (clickInvitation() || attempts >= 10) clearInterval(retryInterval);
          }, 500);
        }
      }
    }

    function showForm() {
      msgBtn.classList.add('active');
      msgBtn.setAttribute('aria-pressed', 'true');
      chatBtn.classList.remove('active');
      chatBtn.setAttribute('aria-pressed', 'false');
      formContainer.classList.add('is-visible');

      // Close chat if it's open
      if (isChatOpen()) clickInvitation();

      if (!formLoaded) {
        var script = document.createElement('script');
        script.type = 'text/javascript';
        script.src = 'https://form.123formbuilder.com/embed/5948756.js';
        script.setAttribute('data-role', 'form');
        script.setAttribute('data-default-width', '650px');
        formContainer.appendChild(script);
        formLoaded = true;
      }
    }

    chatBtn.addEventListener('click', openChat);
    msgBtn.addEventListener('click', showForm);
  })();
</script>
