{% doc %}
  @prompt
    page break line to indicate, a duplicate, but translated, version of the page is below

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-page-break-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px;
    padding: {{ block.settings.padding }}px 0;
  }

  .ai-page-break-line-{{ ai_gen_id }} {
    flex: 1;
    height: {{ block.settings.line_thickness }}px;
    background-color: {{ block.settings.line_color }};
    opacity: {{ block.settings.line_opacity | divided_by: 100.0 }};
  }

  .ai-page-break-text-{{ ai_gen_id }} {
    padding: 0 {{ block.settings.text_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    text-align: center;
    white-space: nowrap;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.text_border_radius }}px;
    {% if block.settings.text_border_thickness > 0 %}
      border: {{ block.settings.text_border_thickness }}px solid {{ block.settings.text_border_color }};
    {% endif %}
    {% if block.settings.show_text_background %}
      padding: {{ block.settings.text_padding }}px {{ block.settings.text_spacing }}px;
    {% endif %}
  }

  .ai-page-break-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 {{ block.settings.icon_spacing }}px;
    color: {{ block.settings.icon_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-page-break-{{ ai_gen_id }} {
      margin: {{ block.settings.margin_top | times: 0.7 }}px 0 {{ block.settings.margin_bottom | times: 0.7 }}px;
    }

    .ai-page-break-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
      padding: 0 {{ block.settings.text_spacing | times: 0.8 }}px;
    }

    .ai-page-break-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
      margin: 0 {{ block.settings.icon_spacing | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-page-break-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-page-break-line-{{ ai_gen_id }}"></div>
  {% if block.settings.show_icon %}
    <svg class="ai-page-break-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      {% case block.settings.icon_type %}
        {% when 'translate' %}
          <path d="M5 8l6 6"></path>
          <path d="M4 14l6-6 2-3"></path>
          <path d="M2 5h12"></path>
          <path d="M7 2h1"></path>
          <path d="M22 22l-5-10-5 10"></path>
          <path d="M14 18h6"></path>
        {% when 'globe' %}
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        {% when 'copy' %}
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        {% when 'arrow_down' %}
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <polyline points="19,12 12,19 5,12"></polyline>
        {% else %}
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12,5 19,12 12,19"></polyline>
      {% endcase %}
    </svg>
  {% endif %}

  {% if block.settings.break_text != blank %}
    <div class="ai-page-break-text-{{ ai_gen_id }}">
      {{ block.settings.break_text }}
    </div>
  {% endif %}

  {% if block.settings.show_icon and block.settings.show_second_icon %}
    <svg class="ai-page-break-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      {% case block.settings.icon_type %}
        {% when 'translate' %}
          <path d="M5 8l6 6"></path>
          <path d="M4 14l6-6 2-3"></path>
          <path d="M2 5h12"></path>
          <path d="M7 2h1"></path>
          <path d="M22 22l-5-10-5 10"></path>
          <path d="M14 18h6"></path>
        {% when 'globe' %}
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        {% when 'copy' %}
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        {% when 'arrow_down' %}
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <polyline points="19,12 12,19 5,12"></polyline>
        {% else %}
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12,5 19,12 12,19"></polyline>
      {% endcase %}
    </svg>
  {% endif %}

  <div class="ai-page-break-line-{{ ai_gen_id }}"></div>
</div>

{% schema %}
{
  "name": "Page break line",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "break_text",
      "label": "Break text",
      "default": "Translated version below"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "select",
      "id": "icon_type",
      "label": "Icon type",
      "options": [
        {
          "value": "translate",
          "label": "Translate"
        },
        {
          "value": "globe",
          "label": "Globe"
        },
        {
          "value": "copy",
          "label": "Copy"
        },
        {
          "value": "arrow_down",
          "label": "Arrow down"
        },
        {
          "value": "arrow_right",
          "label": "Arrow right"
        }
      ],
      "default": "translate"
    },
    {
      "type": "checkbox",
      "id": "show_second_icon",
      "label": "Show second icon",
      "default": false
    },
    {
      "type": "header",
      "content": "Line style"
    },
    {
      "type": "range",
      "id": "line_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Line thickness",
      "default": 2
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "#cccccc"
    },
    {
      "type": "range",
      "id": "line_opacity",
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Line opacity",
      "default": 50
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "text_spacing",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Text spacing",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "show_text_background",
      "label": "Show text background",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Text background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "text_padding",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Text padding",
      "default": 8
    },
    {
      "type": "range",
      "id": "text_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Text border radius",
      "default": 4
    },
    {
      "type": "range",
      "id": "text_border_thickness",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Text border thickness",
      "default": 0
    },
    {
      "type": "color",
      "id": "text_border_color",
      "label": "Text border color",
      "default": "#cccccc"
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 18
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Icon spacing",
      "default": 12
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top margin",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom margin",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Page break line"
    }
  ]
}
{% endschema %}