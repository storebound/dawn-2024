{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if current_tags == blank or current_tags.size == 0 -%}
  {%- assign pagination_count = 1000 -%}
{%- else -%}
  {%- assign pagination_count = 16 -%}
{%- endif -%}

<script>
new MutationObserver(() => {
  document.querySelectorAll('span[role="tab"]').forEach(el => {
    el.setAttribute('role', 'button')
  });
}).observe(document.body, { childList: true, subtree: true });

document.querySelectorAll('span[role="tab"]').forEach(el => {
  el.setAttribute('role', 'button')
})

</script>

{%- paginate blog.articles by pagination_count -%}
  <div class="main-blog page-width section-{{ section.id }}-padding">
    {%- if request.path contains '/blogs/recipes' -%}
    {% else %}
      <h1 class="title--primary{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {{ blog.title | escape }}
      </h1>
    {% endif %}
    {%- if request.path contains '/blogs/recipes' -%}
      {%- assign active_block = null -%}
      {% for block in section.blocks %}
        {% if current_tags contains block.settings.tag %}
          {% assign active_block = block %}
        {% endif %}
      {% endfor %}
      {% assign banner_image = section.settings.default_banner_image %}
      {% assign banner_headline = section.settings.default_banner_headline %}
      {% if active_block != null and active_block.settings.banner_image != blank %}
        {% assign display_image = active_block.settings.banner_image %}
      {% else %}
        {% assign display_image = banner_image %}
      {% endif %}
      {% if display_image == blank %}
        {% assign display_image = 'https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1200&q=80' %}
      {% endif %}
      {%- comment -%}
        If Default Banner Headline is blank, do not fall back to a hardcoded string.
        Only use the Default Banner Headline (even if blank) or the selected block's headline if a tag is active.
      {%- endcomment -%}
      {% if active_block != null and active_block.settings.headline != blank %}
        {% assign display_headline = active_block.settings.headline %}
      {% else %}
        {% assign display_headline = banner_headline %}
      {% endif %}

      <!-- Accessible Breadcrumbs -->
      <nav class="blog-breadcrumbs" aria-label="Breadcrumb">
        <ol class="blog-breadcrumbs__list">
          <li class="blog-breadcrumbs__item">
            <a class="blog-breadcrumbs__link" href="{{ routes.root_url }}">Home</a>
          </li>
          <li class="blog-breadcrumbs__item">
            <a class="blog-breadcrumbs__link" href="{{ blog.url }}">{{ blog.title }}</a>
          </li>
          {% if current_tags and current_tags.size > 0 %}
            <li class="blog-breadcrumbs__item" aria-current="page">
              {{ current_tags | join: ' + ' }}
            </li>
          {% endif %}
        </ol>
      </nav>

      <style>
        .blog-breadcrumbs {
          margin: 0 0 0.75em 0;
          font-size: 0.7em;
          color: rgb(6, 42, 48);
          font-family: inherit;
          text-transform: uppercase;
        }
        .blog-breadcrumbs__list {
          display: flex;
          flex-wrap: wrap;
          align-items: center;
          list-style: none;
          padding: 0;
          margin: 0;
        }
        .blog-breadcrumbs__item {
          display: flex;
          align-items: center;
          font-weight: 500;
          color: rgb(6, 42, 48);
        }
        .blog-breadcrumbs__item:not(:last-child)::after {
          content: '›';
          margin: 0 0.5em;
          color: rgb(6, 42, 48);
          opacity: 0.6;
          font-size: 1.1em;
        }
        .blog-breadcrumbs__link {
          color: rgb(6, 42, 48);
          text-decoration: none;
          transition: text-decoration 0.2s;
        }
        .blog-breadcrumbs__link:focus,
        .blog-breadcrumbs__link:hover {
          text-decoration: underline;
          outline: none;
        }
        .blog-breadcrumbs__item[aria-current='page'] {
          font-weight: 600;
          color: rgb(6, 42, 48);
          text-decoration: none;
          pointer-events: none;
        }
      </style>
      <div class="blog-banner">
        <div class="blog-banner-image">
          <img
            src="{{ display_image | image_url: width: 2000 }}"
            alt="{{ display_headline }}"
            width="100%"
            height="180"
          >

          <div class="blog-banner-text">
            <h1 class="blog-banner-headline">{{ display_headline }}</h1>
            {% if section.settings.secondary_banner_headline != blank %}
              <div class="blog-banner-subheadline">{{ section.settings.secondary_banner_headline }}</div>
            {% endif %}
          </div>
        </div>
      </div>
      <div class="blog-filter-wrapper">
        <!-- Desktop/Tablet Filter List -->
        <div class="blog-filter blog-filter-list">
          {%- comment -%}
            Construct absolute base URL that includes domain and locale path.
          {%- endcomment -%}
          {%- assign base_url_prefix = shop.url | append: request.locale.root_url -%}
          {%- assign base_last = base_url_prefix | slice: -1 -%}
          {%- if base_last != '/' -%}
            {%- assign base_url_prefix = base_url_prefix | append: '/' -%}
          {%- endif -%}
          {% assign all_active = false %}
          {% if current_tags == blank or current_tags.size == 0 %}
            {% assign all_active = true %}
          {% endif %}
          {% if all_active %}
            <span
              class="blog-filter__item blog-filter__item--active"
              role="button"
              aria-selected="true"
              aria-label="Show popular recipes"
              tabindex="0"
            >
              {{ 'sections.main_blog.popular_recipes' | t }}
            </span>
          {% else %}
            <a
              href="{{ base_url_prefix }}blogs/recipes"
              class="blog-filter__item"
              aria-label="Show popular recipes"
              tabindex="0"
            >
              {{ 'sections.main_blog.popular_recipes' | t }}
            </a>
          {% endif %}

          {%- assign sorted_tags = shop.metaobjects.recipe_tag_group.values | sort: 'tag' -%}

          {%- for tag_obj in sorted_tags -%}
            {%- assign tag = tag_obj.tag -%}

            {%- comment -%}
              Determine if the tag should be hidden by default.
              It's hidden only if it's NOT a top category AND it's NOT currently active.
            {%- endcomment -%}
            {%- assign is_top_category = false -%}
            {%- if tag_obj.top_category == true or tag_obj.top_category == 'true' -%}
              {%- assign is_top_category = true -%}
            {%- endif -%}

            {%- assign is_active_tag = false -%}
            {%- if current_tags contains tag -%}
              {%- assign is_active_tag = true -%}
            {%- endif -%}

            {% if is_active_tag %}
              <span
                class="blog-filter__item blog-filter__item--active"
                role="button"
                aria-selected="true"
                aria-label="Filter recipes by {{ tag }}"
                tabindex="0"
              >
                {%- if tag_obj.display_tag != blank -%}
                  {{ tag_obj.display_tag }}
                {%- else -%}
                  {{ tag }}
                {%- endif -%}
              </span>
            {% else %}
              <a
                href="{{ base_url_prefix }}blogs/recipes/tagged/{{ tag | handle }}"
                class="blog-filter__item{% if is_top_category == false %} blog-filter__item--additional{% endif %}"
                aria-label="Filter recipes by {{ tag }}"
                tabindex="0"
              >
                {%- if tag_obj.display_tag != blank -%}
                  {{ tag_obj.display_tag }}
                {%- else -%}
                  {{ tag }}
                {%- endif -%}
              </a>
            {% endif %}
          {%- endfor -%}

          <button
            id="view-all-tags"
            class="blog-filter__view-all"
            type="button"
            aria-expanded="false"
            data-view-all="{{ 'sections.main_blog.view_all' | t }}"
            data-view-less="{{ 'sections.main_blog.view_less' | t }}"
          >
            {{ 'sections.main_blog.view_all' | t }}
          </button>
        </div>

        <style>
          .blog-filter-list:not(.is-expanded) .blog-filter__item--additional {
            display: none;
          }
          .blog-filter__view-all {
            background: none;
            border: none;
            color: rgb(6, 42, 48);
            font-weight: 600;
            cursor: pointer;
            margin-top: 0.5rem;
          }
        </style>
        <script>
          document.addEventListener('DOMContentLoaded', function () {
            var viewAllBtn = document.getElementById('view-all-tags');
            var filterList = document.querySelector('.blog-filter-list');

            if (viewAllBtn && filterList) {
              viewAllBtn.addEventListener('click', function () {
                var isExpanded = filterList.classList.toggle('is-expanded');
                viewAllBtn.setAttribute('aria-expanded', isExpanded.toString());
                viewAllBtn.textContent = isExpanded ? viewAllBtn.dataset.viewLess : viewAllBtn.dataset.viewAll;
              });
            }
          });
        </script>
        <!-- Mobile Dropdown Filter -->
        <div class="blog-filter-dropdown">
          <select onchange="if(this.value) window.location.href=this.value;">
            <option value="">Select Category</option>
            <option
              value="{{ base_url_prefix }}blogs/recipes"
              {% if all_active %}
                selected
              {% endif %}
            >
              {{ 'sections.main_blog.popular_recipes' | t }}
            </option>
            {% assign recipe_tag_group = shop.metaobjects.recipe_tag_group.values %}
            {% for tag_obj in recipe_tag_group %}
              {% assign tag = tag_obj.tag %}
              {% assign is_active = false %}
              {% if current_tags contains tag %}
                {% assign is_active = true %}
              {% endif %}
              <option
                value="{% if is_active %}{{ base_url_prefix }}blogs/recipes{% else %}{{ base_url_prefix }}blogs/recipes/tagged/{{ tag | handle }}{% endif %}"
                {% if is_active %}
                  selected
                {% endif %}
              >
                {%- if tag_obj.display_tag != blank -%}
                  {{ tag_obj.display_tag }}
                {%- else -%}
                  {{ tag }}
                {%- endif -%}
              </option>
            {% endfor %}
          </select>
        </div>
        {% comment %}
          {% for block in section.blocks %}
            {% if current_tags contains block.settings.tag %}
              <div class="blog-filter__banner" style="background-color: {{ block.settings.banner_color }};">
                {% if block.settings.banner_image != blank %}
                  <img src="{{ block.settings.banner_image | img_url: 'master' }}" alt="{{ block.settings.tag }}">
                {% endif %}
                <h2>{{ block.settings.headline }}</h2>
              </div>
            {% endif %}
          {% endfor %}
        {% endcomment %}
      </div>
    {%- endif -%}
    {%- assign tag_color_map = '' -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.tag != blank and block.settings.banner_color != blank -%}
        {%- assign tag_color_map = tag_color_map
          | append: block.settings.tag
          | append: ':'
          | append: block.settings.banner_color
          | append: ','
        -%}
      {%- endif -%}
    {%- endfor -%}
    {% if current_tags == blank or current_tags.size == 0 %}
      {%- comment -%}
        SECTION RENDERING API APPROACH
        ==============================
        Instead of looping through all blog.articles for each category (which hits
        the 50-iteration Liquid limit), we render placeholder containers and use
        JavaScript to fetch each category via the Section Rendering API.

        The key: fetching /blogs/recipes/tagged/{tag}?section_id=category-articles
        means Shopify pre-filters blog.articles to only that tag BEFORE Liquid runs.
        This bypasses the 50-iteration limit entirely.
      {%- endcomment -%}

      <div class="grouped-by-category" id="category-groups-container">
        {% assign recipe_tag_group = shop.metaobjects.recipe_tag_group.values %}
        {% for block in section.blocks %}
          {% assign block_tag = block.settings.tag %}
          {% if block_tag != blank %}
            {% assign matching_metaobject = null %}
            {% for tag_obj in recipe_tag_group %}
              {% if tag_obj.tag == block_tag %}
                {% assign matching_metaobject = tag_obj %}
              {% endif %}
            {% endfor %}
            {% if matching_metaobject %}
              {%- assign display_title = block_tag -%}
              {%- if matching_metaobject.display_tag != blank -%}
                {%- assign display_title = matching_metaobject.display_tag -%}
              {%- endif -%}
              {%- assign articles_count = 3 -%}
              {%- if block.settings.double_articles -%}
                {%- assign articles_count = 7 -%}
              {%- endif -%}

              <div
                class="main-blog-category-group"
                data-category-tag="{{ block_tag | handle }}"
                data-category-display="{{ display_title | escape }}"
                data-articles-count="{{ articles_count }}"
                data-view-more-image="{% if block.settings.view_more_image != blank %}{{ block.settings.view_more_image | image_url: width: 600, height: 600, crop: 'center' }}{% endif %}"
              >
                <h2 class="main-blog-category-header">{{ display_title }}</h2>

                <div class="main-blog-recipekit-grid category-articles-placeholder">
                  {%- comment -%} Skeleton loaders while content loads {%- endcomment -%}
                  {%- for i in (1..articles_count) -%}
                    <div class="recipekit-card-outer skeleton-card">
                      <div class="recipekit-card">
                        <div class="recipekit-card-image-wrapper skeleton-image"></div>
                      </div>
                      <div class="recipekit-card-meta">
                        <div class="skeleton-title"></div>
                      </div>
                    </div>
                  {%- endfor -%}
                  {%- comment -%} View More Card placeholder {%- endcomment -%}
                  <div class="recipekit-card-outer view-more-card skeleton-card">
                    <div class="recipekit-card">
                      <div class="recipekit-card-image-wrapper skeleton-image"></div>
                    </div>
                    <div class="recipekit-card-meta">
                      <div class="skeleton-title"></div>
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>

      <style>
        .skeleton-card {
          animation: skeleton-pulse 1.5s ease-in-out infinite;
        }
        .skeleton-image {
          background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
          background-size: 200% 100%;
          animation: skeleton-shimmer 1.5s infinite;
          aspect-ratio: 1;
          border-radius: 8px;
        }
        .skeleton-title {
          height: 1.2em;
          width: 80%;
          background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
          background-size: 200% 100%;
          animation: skeleton-shimmer 1.5s infinite;
          border-radius: 4px;
          margin-top: 8px;
        }
        @keyframes skeleton-shimmer {
          0% { background-position: 200% 0; }
          100% { background-position: -200% 0; }
        }
        .category-load-error {
          padding: 20px;
          text-align: center;
          color: #666;
          grid-column: 1 / -1;
        }
      </style>

      <script>
        (function() {
          const rootUrl = {{ routes.root_url | json }};
          const blogHandle = {{ blog.handle | json }};
          const defaultViewMoreImage = {{ 'Dash_Pattern_Icon_ca6e694e-c077-41e3-bfcb-71692f0d98f4.png' | file_url | json }};
          const viewMoreText = {{ 'sections.main_blog.view_more_recipes' | t: category: '__CATEGORY__' | json }};

          function loadCategoryArticles(categoryGroup) {
            const tag = categoryGroup.dataset.categoryTag;
            const displayTitle = categoryGroup.dataset.categoryDisplay;
            const articlesCount = parseInt(categoryGroup.dataset.articlesCount, 10) || 7;
            const viewMoreImage = categoryGroup.dataset.viewMoreImage || defaultViewMoreImage;
            const placeholder = categoryGroup.querySelector('.category-articles-placeholder');

            if (!tag || !placeholder) return;

            const tagUrl = `${rootUrl}blogs/${blogHandle}/tagged/${tag}`;
            const sectionUrl = `${tagUrl}?section_id=category-articles`;

            fetch(sectionUrl)
              .then(response => {
                if (!response.ok) throw new Error('Network response was not ok');
                return response.text();
              })
              .then(html => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const articlesContainer = doc.querySelector('.category-articles-grid');

                if (articlesContainer) {
                  const articles = articlesContainer.querySelectorAll('.recipekit-card-outer');
                  const limitedArticles = Array.from(articles).slice(0, articlesCount);

                  placeholder.innerHTML = '';

                  limitedArticles.forEach(article => {
                    placeholder.appendChild(article.cloneNode(true));
                  });

                  const viewMoreCard = document.createElement('div');
                  viewMoreCard.className = 'recipekit-card-outer view-more-card';
                  viewMoreCard.innerHTML = `
                    <a href="${tagUrl}" class="recipekit-card-link" aria-label="View more ${displayTitle} recipes">
                      <div class="recipekit-card">
                        <div class="recipekit-card-image-wrapper">
                          <img
                            class="recipekit-card-image"
                            src="${viewMoreImage}"
                            alt="View More"
                            width="600"
                            height="600"
                            loading="lazy"
                          >
                        </div>
                      </div>
                    </a>
                    <div class="recipekit-card-meta">
                      <a href="${tagUrl}" class="recipekit-card-title-link">
                        <div class="recipekit-card-title">${viewMoreText.replace('__CATEGORY__', displayTitle)}</div>
                      </a>
                    </div>
                  `;
                  placeholder.appendChild(viewMoreCard);
                } else {
                  placeholder.innerHTML = '<p class="category-load-error">No articles found in this category.</p>';
                }
              })
              .catch(error => {
                console.error(`Error loading category ${tag}:`, error);
                placeholder.innerHTML = `<p class="category-load-error">Unable to load articles. <a href="${tagUrl}">View category →</a></p>`;
              });
          }

          function initCategoryLoading() {
            const categoryGroups = document.querySelectorAll('.main-blog-category-group[data-category-tag]');

            if ('IntersectionObserver' in window) {
              const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                  if (entry.isIntersecting) {
                    loadCategoryArticles(entry.target);
                    observer.unobserve(entry.target);
                  }
                });
              }, {
                rootMargin: '200px 0px',
                threshold: 0.01
              });

              categoryGroups.forEach(group => observer.observe(group));
            } else {
              categoryGroups.forEach(loadCategoryArticles);
            }
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initCategoryLoading);
          } else {
            initCategoryLoading();
          }
        })();
      </script>
    {% else %}
      <div class="main-blog-recipekit-grid">
        {%- for article in blog.articles -%}
          {%- assign rk_resource_id = article.id | downcase -%}
          {%- assign rk_mf = article.metafields.recipekit[rk_resource_id] -%}
          <div class="recipekit-card-outer">
            <a href="{{ article.url }}" class="recipekit-card-link" aria-label="{{ article.title | escape }}">
              <div class="recipekit-card">
                <div class="recipekit-card-image-wrapper">
                  {%- if rk_mf and rk_mf.recipe_image != blank -%}
                    {%- assign image_url = rk_mf.recipe_image -%}
                    {%- if image_url contains 'cloudinary.com' -%}
                      {%- assign rk_last_url = image_url | split: 'upload/' -%}
                      {%- assign card_image = rk_last_url[1]
                        | prepend: 'https://res.cloudinary.com/hsxfx8igq/image/upload/t_1x1_recipe_image,f_auto/'
                      -%}
                    {%- elsif image_url contains 'backblazeb2.com' -%}
                      {%- assign rk_last_url = image_url | split: 'backblazeb2.com/file/recipekit-bucket/' -%}
                      {%- assign card_image = 'https://images.getrecipekit.com/'
                        | append: rk_last_url[1]
                        | append: '?aspect_ratio=1:1&quality=90&'
                      -%}
                    {%- elsif image_url contains 'cdn.shopify.com' -%}
                      {%- assign card_image = image_url | append: '&width=1000&height=1000' -%}
                    {%- else -%}
                      {%- assign card_image = image_url -%}
                    {%- endif -%}
                    <img
                      class="recipekit-card-image"
                      src="{{ card_image }}"
                      alt="{{ article.title | escape }}"
                      width="1000"
                      height="1000"
                      loading="lazy"
                    >
                  {%- elsif article.image -%}
                    <img
                      class="recipekit-card-image"
                      src="{{ article.image | image_url: width: 1000, height: 1000, scale: 2 }}"
                      alt="{{ article.title | escape }}"
                      width="1000"
                      height="1000"
                      loading="lazy"
                    >
                  {%- endif -%}
                  {%- assign recipe_rating_num = rk_mf.recipe_rating | plus: 0 -%}
                  {%- assign rating_count_num = rk_mf.rating_count | plus: 0 -%}
                  {% if recipe_rating_num > 4 and rating_count_num > 4 %}
                    <span class="recipekit-top-rated-badge">Top Rated</span>
                  {% endif %}
                  {%- if rk_mf and rk_mf.prep_time != blank -%}
                    <span class="recipekit-prep-time">{{ rk_mf.prep_time }}</span>
                  {%- endif -%}
                </div>
              </div>
            </a>
            <div class="recipekit-card-meta">
              <a href="{{ article.url }}" class="recipekit-card-title-link">
                <div class="recipekit-card-title">{{ article.title }}</div>
              </a>
            </div>
          </div>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- endif -%}
    {% endif %}

    {% if current_tags != blank and current_tags.size > 0 %}
      {% comment %}Find the matching metaobject for the current tag{% endcomment %}
      {% assign matching_tag_obj = null %}
      {% assign recipe_tag_group = shop.metaobjects.recipe_tag_group.values %}
      {% for tag_obj in recipe_tag_group %}
        {% if current_tags contains tag_obj.tag %}
          {% assign matching_tag_obj = tag_obj %}
          {% break %}
        {% endif %}
      {% endfor %}

      {% comment %}Extract product ID from best_selling_product field{% endcomment %}
      {% assign product_id = '' %}
      {% comment %}Default fallback: blank{% endcomment %}
      {% if matching_tag_obj != null and matching_tag_obj.best_selling_product != blank %}
        {% assign best_selling_product = matching_tag_obj.best_selling_product | strip %}
        {% comment %}Extract numeric ID from gid format if needed{% endcomment %}
        {% if best_selling_product contains 'gid://' %}
          {% assign product_id_parts = best_selling_product | split: '/' %}
          {% assign product_id = product_id_parts | last %}
        {% else %}
          {% assign product_id = best_selling_product %}
        {% endif %}
      {% endif %}

      <!-- Product Recommendations Section -->
      <product-recommendations
        class="related-products page-width isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        data-product-id="{{ product_id }}"
        data-url="/recommendations/products?limit=4"
        data-section-id="related-products"
      >
        {% if recommendations.performed and recommendations.products_count > 0 and product_id %}
          <h2 class="related-products__heading inline-richtext main-blog-category-header">You might also like</h2>
          <ul
            class="grid product-grid grid--4-col-desktop grid--2-col-tablet-down"
            role="list"
          >
            {% assign skip_card_product_styles = false %}
            {% for product in recommendations.products %}
              <li class="grid__item">
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: 'square',
                  show_secondary_image: true,
                  show_vendor: false,
                  show_rating: false,
                  skip_styles: skip_card_product_styles
                %}
              </li>
              {%- assign skip_card_product_styles = true -%}
            {% endfor %}
          </ul>
        {% else %}
          <h2 class="related-products__heading inline-richtext main-blog-category-header">
            {{ 'sections.main_blog.popular_products' | t }}
          </h2>
          <ul
            class="grid product-grid grid--4-col-desktop grid--2-col-tablet-down"
            role="list"
          >
            {% assign skip_card_product_styles = false %}
            {% for product in collections.all.products limit: 4 %}
              <li class="grid__item">
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: 'square',
                  show_secondary_image: true,
                  show_vendor: false,
                  show_rating: false,
                  skip_styles: skip_card_product_styles
                %}
              </li>
              {%- assign skip_card_product_styles = true -%}
            {% endfor %}
          </ul>
        {% endif %}
      </product-recommendations>
    {% endif %}
  </div>
{%- endpaginate -%}

