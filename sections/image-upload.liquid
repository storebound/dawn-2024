{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    <div class="upload-card">
      <h1 class="upload-title h1">{{ section.settings.heading }}</h1>

      <div id="token-error" class="token-error" hidden>
        <div class="token-error__icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
        </div>
        <p class="token-error__title">Invalid or missing upload link</p>
        <p class="token-error__message">This upload link is invalid, expired, or has already been used. Please request a new link from customer service, or email your image directly to <a href="mailto:support@bydash.com">support@bydash.com</a></p>
      </div>

      <div id="upload-content">
        {%- if section.settings.show_reference_image and section.settings.reference_image_url != blank -%}
          <div class="reference-image">
            <p class="reference-image__label">{{ section.settings.reference_label }}</p>
            <img
              src="{{ section.settings.reference_image_url }}"
              alt="{{ section.settings.reference_label }}"
              class="reference-image__img"
              width="400"
              height="300"
              loading="lazy"
            >
            {%- if section.settings.reference_caption != blank -%}
              <p class="reference-image__caption">{{ section.settings.reference_caption }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div id="upload-area" class="upload-area">
        <div class="upload-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
        </div>
        <p class="upload-text">Drag and drop your image here</p>
        <p class="upload-subtext">or</p>
        <button type="button" id="browse-btn" class="button button--secondary">Browse Files</button>
        <input type="file" id="file-input" accept="image/jpeg,image/png,image/gif,image/heic,image/heif" hidden>
        <p class="upload-hint">JPEG, PNG, GIF, or HEIC - Max 10MB</p>
      </div>

      <div id="preview-area" class="preview-area" hidden>
        <img id="preview-image" class="preview-image" alt="Preview" width="400" height="300">
        <div class="preview-info">
          <span id="file-name" class="file-name"></span>
          <span id="file-size" class="file-size"></span>
        </div>
        <button type="button" id="remove-btn" class="remove-btn">Remove</button>
      </div>

      <div id="progress-area" class="progress-area" hidden>
        <div class="progress-bar">
          <div id="progress-fill" class="progress-fill"></div>
        </div>
        <span id="progress-text" class="progress-text">Uploading... 0%</span>
      </div>

      <div id="message-area" class="message-area" hidden>
        <div id="message-content" class="message-content"></div>
      </div>

      <button type="button" id="upload-btn" class="button" disabled>Upload Image</button>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
.upload-card {
  background: rgb(var(--color-background));
  border-radius: var(--buttons-radius);
  box-shadow: 0 2px 12px rgba(var(--color-foreground), 0.08);
  padding: 40px;
  width: 100%;
  max-width: 520px;
  margin: 0 auto;
}

.upload-title {
  margin: 0 0 24px;
  text-align: center;
  color: rgb(var(--color-foreground));
}

.reference-image {
  text-align: center;
  margin-bottom: 24px;
  padding-bottom: 24px;
  border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
}

.reference-image__label {
  font-size: 1.4rem;
  font-weight: 600;
  color: rgb(var(--color-foreground));
  margin: 0 0 12px;
}

.reference-image__img {
  max-width: 100%;
  max-height: 200px;
  border-radius: var(--buttons-radius);
  object-fit: contain;
}

.reference-image__caption {
  font-size: 1.3rem;
  color: rgba(var(--color-foreground), 0.7);
  margin: 12px 0 0;
  line-height: 1.5;
}

.upload-area {
  border: 2px dashed rgba(var(--color-foreground), 0.2);
  border-radius: var(--buttons-radius);
  padding: 40px 20px;
  text-align: center;
  transition: border-color 0.2s, background-color 0.2s;
  cursor: pointer;
}

.upload-area:hover,
.upload-area.dragover {
  border-color: rgb(var(--color-button));
  background-color: rgba(var(--color-button), 0.05);
}

.upload-icon {
  color: rgba(var(--color-foreground), 0.6);
  margin-bottom: 16px;
}

.upload-text {
  font-size: 1.6rem;
  color: rgb(var(--color-foreground));
  margin: 0 0 8px;
}

.upload-subtext {
  font-size: 1.4rem;
  color: rgba(var(--color-foreground), 0.7);
  margin: 0 0 16px;
}

.upload-hint {
  font-size: 1.2rem;
  color: rgba(var(--color-foreground), 0.6);
  margin: 16px 0 0;
}

.preview-area {
  border: 1px solid rgba(var(--color-foreground), 0.15);
  border-radius: var(--buttons-radius);
  padding: 16px;
  text-align: center;
}

.preview-image {
  max-width: 100%;
  max-height: 200px;
  border-radius: 4px;
  margin-bottom: 12px;
  object-fit: contain;
}

.preview-info {
  display: flex;
  justify-content: center;
  gap: 16px;
  font-size: 1.4rem;
  color: rgba(var(--color-foreground), 0.7);
  margin-bottom: 12px;
}

.file-name {
  font-weight: 500;
  color: rgb(var(--color-foreground));
  max-width: 200px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.remove-btn {
  background: none;
  border: 1px solid rgba(var(--color-foreground), 0.3);
  color: rgb(var(--color-foreground));
  padding: 8px 20px;
  border-radius: var(--buttons-radius);
  font-size: 1.3rem;
  cursor: pointer;
  transition: background-color 0.2s, color 0.2s, border-color 0.2s;
}

.remove-btn:hover {
  background: rgba(var(--color-foreground), 0.1);
  border-color: rgba(var(--color-foreground), 0.5);
}

.progress-area {
  margin-top: 20px;
}

.progress-bar {
  height: 8px;
  background: rgba(var(--color-foreground), 0.1);
  border-radius: 4px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: rgb(var(--color-button));
  width: 0%;
  transition: width 0.3s;
}

.progress-text {
  display: block;
  text-align: center;
  font-size: 1.3rem;
  color: rgba(var(--color-foreground), 0.7);
  margin-top: 8px;
}

.message-area {
  margin-top: 20px;
}

.message-content {
  padding: 12px 16px;
  border-radius: var(--buttons-radius);
  font-size: 1.4rem;
  text-align: center;
}

.message-content.success {
  background: rgba(22, 163, 74, 0.1);
  color: rgb(22, 163, 74);
  border: 1px solid rgba(22, 163, 74, 0.3);
}

.message-content.error {
  background: rgba(220, 38, 38, 0.1);
  color: rgb(220, 38, 38);
  border: 1px solid rgba(220, 38, 38, 0.3);
}

#upload-btn {
  width: 100%;
  margin-top: 20px;
}

#upload-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.token-error {
  text-align: center;
  padding: 40px 20px;
}

.token-error__icon {
  color: rgba(220, 38, 38, 0.8);
  margin-bottom: 20px;
}

.token-error__title {
  font-size: 1.8rem;
  font-weight: 600;
  color: rgb(var(--color-foreground));
  margin: 0 0 12px;
}

.token-error__message {
  font-size: 1.4rem;
  color: rgba(var(--color-foreground), 0.7);
  margin: 0;
  line-height: 1.6;
}

.token-error__message a {
  color: rgb(var(--color-foreground));
  font-weight: 500;
}
{% endstylesheet %}

{% javascript %}
(function() {
  // ============================================
  // CONFIGURATION - Update these values
  // ============================================
  const CONFIG = {
    // Premier NX API endpoint - UPDATE THIS when provided
    apiEndpoint: 'https://y2tp4wlqlb.execute-api.us-west-2.amazonaws.com/upload-file',

    // Validation settings (from spec)
    maxFileSize: 10 * 1024 * 1024, // 10MB
    allowedTypes: ['image/jpeg', 'image/png', 'image/gif', 'image/heic', 'image/heif'],
    minDimension: 256,
    maxDimension: 10000
  };
  // ============================================

  const elements = {
    tokenError: document.getElementById('token-error'),
    uploadContent: document.getElementById('upload-content'),
    uploadArea: document.getElementById('upload-area'),
    fileInput: document.getElementById('file-input'),
    browseBtn: document.getElementById('browse-btn'),
    previewArea: document.getElementById('preview-area'),
    previewImage: document.getElementById('preview-image'),
    fileName: document.getElementById('file-name'),
    fileSize: document.getElementById('file-size'),
    removeBtn: document.getElementById('remove-btn'),
    progressArea: document.getElementById('progress-area'),
    progressFill: document.getElementById('progress-fill'),
    progressText: document.getElementById('progress-text'),
    messageArea: document.getElementById('message-area'),
    messageContent: document.getElementById('message-content'),
    uploadBtn: document.getElementById('upload-btn')
  };

  let selectedFile = null;
  let uploadToken = null;

  // Get token from URL
  function getTokenFromUrl() {
    const params = new URLSearchParams(window.location.search);
    return params.get('token');
  }

  // Format file size
  function formatFileSize(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }

  // Show message
  function showMessage(text, type) {
    elements.messageContent.textContent = text;
    elements.messageContent.className = 'message-content ' + type;
    elements.messageArea.hidden = false;
  }

  // Hide message
  function hideMessage() {
    elements.messageArea.hidden = true;
  }

  // Check if file is HEIC based on extension (browsers often don't detect HEIC MIME type)
  function isHeicFile(file) {
    const ext = file.name.split('.').pop().toLowerCase();
    return ext === 'heic' || ext === 'heif' || file.type === 'image/heic' || file.type === 'image/heif';
  }

  // Validate file type
  function validateFileType(file) {
    // Check MIME type first
    if (CONFIG.allowedTypes.includes(file.type)) {
      return null;
    }
    // Fallback: check file extension for HEIC (browsers often report empty/wrong MIME type)
    if (isHeicFile(file)) {
      return null;
    }
    // Also check common image extensions as fallback
    const ext = file.name.split('.').pop().toLowerCase();
    const allowedExtensions = ['jpg', 'jpeg', 'png', 'gif', 'heic', 'heif'];
    if (allowedExtensions.includes(ext)) {
      return null;
    }
    return 'Invalid file type. Please upload a JPEG, PNG, GIF, or HEIC image.';
  }

  // Validate file size
  function validateFileSize(file) {
    if (file.size > CONFIG.maxFileSize) {
      return 'File is too large. Maximum size is 10MB.';
    }
    return null;
  }

  // Validate image dimensions
  function validateDimensions(img) {
    const width = img.naturalWidth;
    const height = img.naturalHeight;

    if (width < CONFIG.minDimension || height < CONFIG.minDimension) {
      return `Image is too small. Minimum dimensions are ${CONFIG.minDimension}x${CONFIG.minDimension} pixels.`;
    }
    if (width > CONFIG.maxDimension || height > CONFIG.maxDimension) {
      return `Image is too large. Maximum dimensions are ${CONFIG.maxDimension}x${CONFIG.maxDimension} pixels.`;
    }
    return null;
  }

  // Handle file selection
  function handleFile(file) {
    hideMessage();

    // Validate type
    let error = validateFileType(file);
    if (error) {
      showMessage(error, 'error');
      return;
    }

    // Validate size
    error = validateFileSize(file);
    if (error) {
      showMessage(error, 'error');
      return;
    }

    // HEIC files can't be previewed in most desktop browsers - skip image validation
    if (isHeicFile(file)) {
      selectedFile = file;
      // Show placeholder for HEIC since browsers can't display it
      elements.previewImage.src = 'data:image/svg+xml,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="200" height="150" viewBox="0 0 200 150"><rect fill="#f3f4f6" width="200" height="150"/><circle cx="100" cy="50" r="24" fill="#22c55e"/><path d="M90 50 L97 57 L112 42" stroke="white" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/><text x="100" y="95" text-anchor="middle" fill="#6b7280" font-family="system-ui" font-size="14">HEIC Image Selected</text><text x="100" y="115" text-anchor="middle" fill="#9ca3af" font-family="system-ui" font-size="12">(Preview not available)</text></svg>');
      elements.fileName.textContent = file.name;
      elements.fileSize.textContent = formatFileSize(file.size);
      elements.uploadArea.hidden = true;
      elements.previewArea.hidden = false;
      elements.uploadBtn.disabled = false;
      return;
    }

    // Create preview and validate dimensions for other image types
    const reader = new FileReader();
    reader.onload = function(e) {
      const img = new Image();
      img.onload = function() {
        error = validateDimensions(img);
        if (error) {
          showMessage(error, 'error');
          return;
        }

        // File is valid
        selectedFile = file;
        elements.previewImage.src = e.target.result;
        elements.fileName.textContent = file.name;
        elements.fileSize.textContent = formatFileSize(file.size);
        elements.uploadArea.hidden = true;
        elements.previewArea.hidden = false;
        elements.uploadBtn.disabled = false;
      };
      img.onerror = function() {
        // Image failed to load - might be unsupported format, allow upload anyway
        selectedFile = file;
        elements.previewImage.src = 'data:image/svg+xml,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="200" height="150" viewBox="0 0 200 150"><rect fill="#f3f4f6" width="200" height="150"/><text x="100" y="75" text-anchor="middle" fill="#6b7280" font-family="system-ui" font-size="14">Preview not available</text></svg>');
        elements.fileName.textContent = file.name;
        elements.fileSize.textContent = formatFileSize(file.size);
        elements.uploadArea.hidden = true;
        elements.previewArea.hidden = false;
        elements.uploadBtn.disabled = false;
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  }

  // Remove selected file
  function removeFile() {
    selectedFile = null;
    elements.fileInput.value = '';
    elements.previewArea.hidden = true;
    elements.uploadArea.hidden = false;
    elements.uploadBtn.disabled = true;
    hideMessage();
  }

  // Upload file
  async function uploadFile() {
    if (!selectedFile || !uploadToken) return;

    elements.uploadBtn.disabled = true;
    elements.progressArea.hidden = false;
    elements.progressFill.style.width = '0%';
    elements.progressText.textContent = 'Requesting upload URL...';
    hideMessage();

    try {
      // Step 1: Get presigned URL from Premier NX API
      const presignResponse = await fetch(CONFIG.apiEndpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          fileName: selectedFile.name,
          fileType: selectedFile.type,
          token: uploadToken
        })
      });

      if (!presignResponse.ok) {
        const errorData = await presignResponse.json().catch(() => ({}));
        const apiError = errorData.Error || errorData.error || '';
        const supportMsg = 'Please request a new link from customer service, or email your image directly to support@bydash.com';
        if (apiError) {
          throw new Error(apiError + '. ' + supportMsg);
        }
        throw new Error('Failed to get upload URL. ' + supportMsg);
      }

      const presignData = await presignResponse.json();

      if (!presignData.uploadUrl) {
        throw new Error('Invalid response from server. Please try again, or email your image to support@bydash.com');
      }

      // Step 2: Upload directly to S3
      elements.progressText.textContent = 'Uploading...';

      await new Promise((resolve, reject) => {
        const xhr = new XMLHttpRequest();

        xhr.upload.addEventListener('progress', function(e) {
          if (e.lengthComputable) {
            const percent = Math.round((e.loaded / e.total) * 100);
            elements.progressFill.style.width = percent + '%';
            elements.progressText.textContent = 'Uploading... ' + percent + '%';
          }
        });

        xhr.addEventListener('load', function() {
          if (xhr.status === 200) {
            resolve();
          } else {
            reject(new Error('Upload failed. Please try again, or email your image to support@bydash.com'));
          }
        });

        xhr.addEventListener('error', function() {
          reject(new Error('Upload failed. Please check your connection and try again, or email your image to support@bydash.com'));
        });

        xhr.open('PUT', presignData.uploadUrl);
        xhr.setRequestHeader('Content-Type', selectedFile.type);
        xhr.send(selectedFile);
      });

      // Success
      elements.progressArea.hidden = true;
      showMessage('Image uploaded successfully!', 'success');
      elements.uploadBtn.textContent = 'Upload Complete';

    } catch (error) {
      elements.progressArea.hidden = true;
      showMessage(error.message, 'error');
      elements.uploadBtn.disabled = false;
    }
  }

  // Initialize
  function init() {
    uploadToken = getTokenFromUrl();

    if (!uploadToken) {
      elements.tokenError.hidden = false;
      elements.uploadContent.hidden = true;
      return;
    }

    // Browse button click
    elements.browseBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      elements.fileInput.click();
    });

    // Upload area click
    elements.uploadArea.addEventListener('click', function() {
      elements.fileInput.click();
    });

    // File input change
    elements.fileInput.addEventListener('change', function() {
      if (this.files && this.files[0]) {
        handleFile(this.files[0]);
      }
    });

    // Drag and drop
    elements.uploadArea.addEventListener('dragover', function(e) {
      e.preventDefault();
      this.classList.add('dragover');
    });

    elements.uploadArea.addEventListener('dragleave', function(e) {
      e.preventDefault();
      this.classList.remove('dragover');
    });

    elements.uploadArea.addEventListener('drop', function(e) {
      e.preventDefault();
      this.classList.remove('dragover');
      if (e.dataTransfer.files && e.dataTransfer.files[0]) {
        handleFile(e.dataTransfer.files[0]);
      }
    });

    // Remove button
    elements.removeBtn.addEventListener('click', removeFile);

    // Upload button
    elements.uploadBtn.addEventListener('click', uploadFile);
  }

  // Run when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
{% endjavascript %}

{% schema %}
{
  "name": "Image Upload",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Upload Image",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Reference image"
    },
    {
      "type": "checkbox",
      "id": "show_reference_image",
      "default": true,
      "label": "Show reference image"
    },
    {
      "type": "text",
      "id": "reference_label",
      "default": "Please take a photo similar to this example:",
      "label": "Reference label"
    },
    {
      "type": "text",
      "id": "reference_image_url",
      "default": "https://cdn.shopify.com/s/files/1/0173/8181/8422/files/97756000.jpg",
      "label": "Reference image URL"
    },
    {
      "type": "text",
      "id": "reference_caption",
      "default": "Take a clear photo of the product label showing the model number",
      "label": "Reference caption"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Image Upload"
    }
  ]
}
{% endschema %}
