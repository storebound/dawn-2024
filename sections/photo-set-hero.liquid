{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif

  assign desktop_image = section.settings.image
  if desktop_image == blank
    assign desktop_image = section.settings.mobile_image
  endif

  assign mobile_image = section.settings.mobile_image
  if mobile_image == blank
    assign mobile_image = desktop_image
  endif

  assign media_alt = section.settings.media_alt | strip
  if media_alt == blank and desktop_image != blank and desktop_image.alt != blank
    assign media_alt = desktop_image.alt
  endif
  if media_alt == blank
    assign media_alt = section.settings.heading | strip_html
  endif

  assign section_link = section.settings.section_link
  assign full_section_label = section.settings.link_label | strip
  if full_section_label == blank
    assign full_section_label = section.settings.heading | strip_html | strip
  endif
  if full_section_label == blank
    assign full_section_label = section.settings.subheading | strip_html | strip
  endif
  if full_section_label == blank
    assign full_section_label = media_alt
  endif

  assign button_link = section.settings.button_link

  capture desktop_sizes
    echo '(min-width: '
    echo section.settings.content_max_width
    echo 'px) '
    echo section.settings.content_max_width | times: section.settings.media_width | divided_by: 100 | round
    echo 'px, (min-width: 990px) '
    echo section.settings.media_width
    echo 'vw, 100vw'
  endcapture
-%}

{% style %}
  #PhotoSetHero-{{ section.id }} {
    --photo-set-hero-max-width: {{ section.settings.content_max_width }}px;
    --photo-set-hero-max-height: {{ section.settings.section_max_height }}px;
    --photo-set-hero-media-width: {{ section.settings.media_width }}%;
    --photo-set-hero-copy-max-width: {{ section.settings.copy_max_width }}px;
    --photo-set-hero-content-gap: {{ section.settings.content_gap }}px;
    --photo-set-hero-bg-top: {{ section.settings.background_top }};
    --photo-set-hero-bg-bottom: {{ section.settings.background_bottom }};
    --photo-set-hero-blob: {{ section.settings.blob_color }};
    --photo-set-hero-heading: {{ section.settings.heading_color }};
    --photo-set-hero-body: {{ section.settings.body_color }};
    --photo-set-hero-transition-point: 67%;
    --photo-set-hero-transition-width: 12%;
  }
{% endstyle %}

<section id="PhotoSetHero-{{ section.id }}" class="photo-set-hero{% if section_link != blank %} photo-set-hero--linked{% endif %}">
  {%- if section_link != blank and full_section_label != blank -%}
    <a class="photo-set-hero__full-link full-width-link" href="{{ section_link }}">
      <span class="visually-hidden">{{ full_section_label | escape }}</span>
    </a>
  {%- endif -%}

  <div class="photo-set-hero__inner">
    <div class="photo-set-hero__media-column">
      <div class="photo-set-hero__media-wrap">
        {%- if desktop_image != blank -%}
          <picture class="photo-set-hero__picture">
            {%- if mobile_image != blank -%}
              <source
                media="(max-width: 749px)"
                sizes="100vw"
                srcset="
                  {{ mobile_image | image_url: width: 400 }} 400w,
                  {{ mobile_image | image_url: width: 640 }} 640w,
                  {{ mobile_image | image_url: width: 900 }} 900w,
                  {{ mobile_image | image_url: width: 1200 }} 1200w
                "
              >
            {%- endif -%}
            {{
              desktop_image
              | image_url: width: 2400
              | image_tag:
                class: 'photo-set-hero__image',
                widths: '480, 720, 960, 1280, 1600, 2000, 2400',
                sizes: desktop_sizes,
                alt: media_alt,
                fetchpriority: fetch_priority
            }}
          </picture>
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'photo-set-hero__placeholder' }}
        {%- endif -%}
      </div>
    </div>

    <div class="photo-set-hero__content-column">
      <div class="photo-set-hero__content">
        <div class="photo-set-hero__blob" aria-hidden="true">
          <svg viewBox="0 0 980 760" preserveAspectRatio="none" focusable="false">
            <path d="M186 144C299 48 518 18 703 62C846 96 936 196 952 326C970 468 936 594 849 678C766 758 645 764 552 731C498 712 467 669 423 660C369 649 323 705 244 716C154 728 72 693 30 620C11 586 6 544 8 502C10 444 24 382 53 322C83 251 126 191 186 144Z" fill="currentColor"></path>
          </svg>
        </div>

        {%- if section.settings.heading != blank -%}
          <h2 class="photo-set-hero__heading inline-richtext">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <div class="photo-set-hero__subheading rte">
            {{ section.settings.subheading }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank and button_link != blank -%}
          <div class="photo-set-hero__button-wrapper">
            <a
              href="{{ button_link }}"
              class="photo-set-hero__button button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
            >
              {{ section.settings.button_label | escape }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .photo-set-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    min-height: clamp(36rem, 42vw, var(--photo-set-hero-max-height));
    background:
      radial-gradient(circle at 20% 14%, rgba(255, 255, 255, 0.48) 0, rgba(255, 255, 255, 0) 34%),
      radial-gradient(circle at 78% 18%, rgba(255, 255, 255, 0.24) 0, rgba(255, 255, 255, 0) 32%),
      linear-gradient(
        180deg,
        var(--photo-set-hero-bg-top) 0%,
        var(--photo-set-hero-bg-top) calc(var(--photo-set-hero-transition-point) - var(--photo-set-hero-transition-width)),
        var(--photo-set-hero-bg-bottom) calc(var(--photo-set-hero-transition-point) + var(--photo-set-hero-transition-width)),
        var(--photo-set-hero-bg-bottom) 100%
      );
  }

  .photo-set-hero--linked {
    cursor: pointer;
  }

  .photo-set-hero__full-link {
    z-index: 2;
  }

  .photo-set-hero__full-link:focus-visible {
    outline: 0.3rem solid rgba(17, 17, 17, 0.72);
    outline-offset: -0.3rem;
  }

  .photo-set-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0) 0,
      rgba(255, 255, 255, 0) calc(var(--photo-set-hero-transition-point) - 4%),
      rgba(255, 255, 255, 0.16) var(--photo-set-hero-transition-point),
      rgba(255, 255, 255, 0) calc(var(--photo-set-hero-transition-point) + 4%),
      rgba(255, 255, 255, 0) 100%
    );
    pointer-events: none;
    z-index: -1;
  }

  .photo-set-hero::after {
    display: none;
  }

  .photo-set-hero__inner {
    display: flex;
    align-items: stretch;
    gap: var(--photo-set-hero-content-gap);
    width: min(100%, var(--photo-set-hero-max-width));
    min-height: inherit;
    margin: 0 auto;
    padding: clamp(2rem, 3vw, 3.6rem) clamp(1.6rem, 3vw, 4rem) 0;
    box-sizing: border-box;
  }

  .photo-set-hero__media-column,
  .photo-set-hero__content-column {
    min-width: 0;
  }

  .photo-set-hero__media-column {
    flex: 0 1 var(--photo-set-hero-media-width);
    max-width: var(--photo-set-hero-media-width);
    display: flex;
    align-items: flex-end;
  }

  .photo-set-hero__media-wrap {
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
  }

  .photo-set-hero__picture {
    display: flex;
    align-items: flex-end;
    width: 100%;
    height: 100%;
  }

  .photo-set-hero__image,
  .photo-set-hero__placeholder {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(var(--photo-set-hero-max-height) - 4.8rem);
    object-fit: contain;
    object-position: left bottom;
  }

  .photo-set-hero__placeholder {
    min-height: 26rem;
    fill: rgba(255, 255, 255, 0.72);
  }

  .photo-set-hero__content-column {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: clamp(0rem, 1.8vw, 2.4rem);
    overflow: visible;
  }

  .photo-set-hero__content {
    position: relative;
    isolation: isolate;
    width: min(100%, max(var(--photo-set-hero-copy-max-width), 51rem));
    margin-right: 0;
    padding:
      clamp(5.6rem, 6.2vw, 7.2rem)
      clamp(3.1rem, 3.8vw, 4.6rem)
      clamp(5rem, 5.2vw, 5.8rem)
      clamp(4rem, 4.8vw, 5.4rem);
    --photo-set-hero-blob-width-extra: clamp(9rem, 12vw, 16rem);
    --photo-set-hero-blob-height-extra: clamp(5.5rem, 7vw, 8rem);
    --photo-set-hero-blob-shift-x: clamp(2rem, 2.8vw, 4rem);
    --photo-set-hero-blob-shift-y: clamp(1.8rem, 2vw, 2.6rem);
    text-align: center;
    color: var(--photo-set-hero-body);
  }

  .photo-set-hero__blob {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(100% + var(--photo-set-hero-blob-width-extra));
    height: calc(100% + var(--photo-set-hero-blob-height-extra));
    transform: translate(
      calc(-50% + var(--photo-set-hero-blob-shift-x)),
      calc(-50% - var(--photo-set-hero-blob-shift-y))
    );
    z-index: -1;
    pointer-events: none;
    color: var(--photo-set-hero-blob);
    filter: drop-shadow(0 2.2rem 3.2rem rgba(122, 183, 177, 0.14));
  }

  .photo-set-hero__blob svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .photo-set-hero__heading {
    margin: 0;
    width: min(100%, 14.4ch);
    max-width: 14.4ch;
    margin-inline: auto;
    color: var(--photo-set-hero-heading);
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 700;
    font-size: clamp(2.7rem, 3.5vw, 4.8rem);
    line-height: 0.94;
    letter-spacing: -0.04em;
    word-break: normal;
    overflow-wrap: normal;
    hyphens: none;
    text-wrap: pretty;
  }

  .photo-set-hero__subheading {
    margin-top: 2rem;
    max-width: 18ch;
    margin-inline: auto;
    color: var(--photo-set-hero-body);
    font-size: clamp(1.8rem, 2vw, 3.2rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .photo-set-hero__subheading p {
    margin: 0;
  }

  .photo-set-hero__subheading p + p {
    margin-top: 0.8rem;
  }

  .photo-set-hero__button-wrapper {
    position: relative;
    z-index: 3;
    margin-top: 2.4rem;
  }

  .photo-set-hero__button {
    position: relative;
    z-index: 3;
  }

  @media screen and (max-width: 989px) and (min-width: 750px) {
    .photo-set-hero {
      min-height: clamp(34rem, 50vw, var(--photo-set-hero-max-height));
    }

    .photo-set-hero__inner {
      gap: clamp(1.6rem, 2.2vw, 2.8rem);
      padding-inline: clamp(1.6rem, 2.2vw, 2.6rem);
    }

    .photo-set-hero__media-column {
      flex-basis: 54%;
      max-width: 54%;
    }

    .photo-set-hero__content-column {
      padding-right: 0;
    }

    .photo-set-hero__content {
      width: min(100%, max(var(--photo-set-hero-copy-max-width), 45rem));
      padding: 4.8rem 2.6rem 4.8rem 3.6rem;
      --photo-set-hero-blob-width-extra: 7rem;
      --photo-set-hero-blob-height-extra: 6.5rem;
      --photo-set-hero-blob-shift-x: 1.6rem;
      --photo-set-hero-blob-shift-y: 1.6rem;
    }

    .photo-set-hero__heading {
      width: min(100%, 14.2ch);
      max-width: 14.2ch;
      font-size: clamp(2.4rem, 3vw, 3.8rem);
    }

    .photo-set-hero__subheading {
      font-size: clamp(1.7rem, 2.4vw, 2.4rem);
    }

    .photo-set-hero__button-wrapper {
      margin-top: 2rem;
    }
  }

  @media screen and (max-width: 749px) {
    .photo-set-hero {
      --photo-set-hero-transition-point: 42%;
      --photo-set-hero-transition-width: 8%;
      min-height: 0;
    }

    .photo-set-hero__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      width: 100%;
      padding: 2rem 1.6rem 0;
    }

    .photo-set-hero__media-column {
      flex-basis: auto;
      max-width: none;
      justify-content: center;
    }

    .photo-set-hero__media-wrap,
    .photo-set-hero__picture {
      justify-content: center;
    }

    .photo-set-hero__image,
    .photo-set-hero__placeholder {
      width: min(100%, 36rem);
      max-height: none;
      object-position: center bottom;
      margin: 0 auto;
    }

    .photo-set-hero__content-column {
      position: relative;
      width: calc(100% + 3.2rem);
      margin-inline: -1.6rem;
      justify-content: flex-start;
      padding-right: 0;
    }

    .photo-set-hero__content {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 5.2rem 2rem 4rem;
      background: var(--photo-set-hero-blob);
      clip-path: polygon(
        0 16%,
        8% 12%,
        18% 8%,
        30% 6%,
        42% 8%,
        54% 12%,
        66% 14%,
        79% 11%,
        90% 7%,
        100% 4%,
        100% 100%,
        0 100%
      );
      overflow: hidden;
    }

    .photo-set-hero__blob {
      display: none;
    }

    .photo-set-hero__heading {
      width: min(100%, 12.8ch);
      max-width: 12.8ch;
      font-size: clamp(2.5rem, 8vw, 3.8rem);
    }

    .photo-set-hero__subheading {
      font-size: clamp(1.8rem, 5.4vw, 2.4rem);
    }

    .photo-set-hero__button-wrapper {
      margin-top: 1.8rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Photo set hero",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "media_alt",
      "label": "Image alt text",
      "info": "Optional. Falls back to the uploaded image alt text."
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Frozen treat freshness"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Soft serve, slushies &amp; shaved ice, oh my!</p>"
    },
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "url",
      "id": "section_link",
      "label": "Section link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Section link label",
      "info": "Used for screen readers. Falls back to the heading, then subheading, then image alt text."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Button only appears when both label and link are set."
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "label": "Use secondary button style",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 1100,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "range",
      "id": "section_max_height",
      "label": "Desktop max height",
      "min": 380,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Desktop media width",
      "min": 50,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 60
    },
    {
      "type": "range",
      "id": "copy_max_width",
      "label": "Copy max width",
      "min": 340,
      "max": 560,
      "step": 10,
      "unit": "px",
      "default": 470
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Column gap",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_top",
      "label": "Background top",
      "default": "#c8f0eb"
    },
    {
      "type": "color",
      "id": "background_bottom",
      "label": "Background bottom",
      "default": "#bcecea"
    },
    {
      "type": "color",
      "id": "blob_color",
      "label": "Blob color",
      "default": "#eaf4f3"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#f60231"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body color",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Photo set hero"
    }
  ]
}
{% endschema %}
